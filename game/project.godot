; Engine configuration file.
; Godot 4.7 .NET. Edit through the editor where possible.

config_version=5

[application]

config/name="Tide & Toll"
config/description="A town-builder where you never draw a road."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="TideToll"

[importer_defaults]

; SVG icons are rasterised at 4x (96 px for the 24 px designs); the interface adds mipmaps and draws them at
; 24 to 32 px, so they stay crisp at any interface scale. Only affects SVG files.
texture={
"svg/scale": 4.0
}

[rendering]

renderer/rendering_method="mobile"
