<Project Sdk="Godot.NET.Sdk/4.7.0">
  <!-- Godot.NET.Sdk 4.7.0 ships only inside the Godot download (GodotSharp/Tools/nupkgs).
       The Godot editor registers that folder with NuGet when it opens; tools/setup-linux.sh
       does the same for headless machines. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>TideToll.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same simulation library the tests run, always built optimised: a Debug sim is three to five times
         slower per tick, which would make every run from the editor or the command line misjudge the game's speed.
         Optimisation does not change results (.NET has no fast-math), and the sim's own tests run in Release too. -->
    <ProjectReference Include="..\sim\TideToll.Sim.csproj" AdditionalProperties="Configuration=Release" />
  </ItemGroup>
</Project>
